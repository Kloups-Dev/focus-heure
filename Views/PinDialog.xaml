<Window x:Class="FocusHeure.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code PIN"
        Height="220"
        Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="24">
        <TextBlock Text="Entrez le code PIN pour quitter"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   Foreground="#333333"
                   Margin="0,0,0,12" />
        <PasswordBox x:Name="PinBox"
                     FontSize="18"
                     Padding="8,6"
                     MaxLength="8" />
        <TextBlock x:Name="ErrorText"
                   Foreground="#CC3333"
                   FontSize="12"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Annuler"
                    Click="Cancel_OnClick"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Background="#EEEEEE"
                    BorderThickness="0" />
            <Button Content="Valider"
                    Click="Ok_OnClick"
                    Padding="16,8"
                    Background="#111111"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </StackPanel>
</Window>
