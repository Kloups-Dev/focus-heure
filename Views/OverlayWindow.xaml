<Window x:Class="FocusHeure.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusHeure"
        Background="White"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        KeyDown="Window_OnKeyDown">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="ClockText"
                       Text="00:00"
                       FontFamily="{StaticResource BebasNeue}"
                       FontSize="160"
                       FontWeight="Bold"
                       Foreground="#111111"
                       HorizontalAlignment="Center"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType" />
            <TextBlock x:Name="CountdownText"
                       Text=""
                       FontFamily="{StaticResource BebasNeue}"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="#444444"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />
            <TextBlock x:Name="BlockText"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="15"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Opacity="0.85" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   Text="Mode concentration"
                   FontFamily="Segoe UI Light"
                   FontSize="13"
                   Foreground="#999999"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="2"
                   Text="Échap + Entrée = pause"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Foreground="#BBBBBB"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <Button Grid.Row="3"
                x:Name="ChromeButton"
                Content="Ouvrir Chrome au-dessus"
                Click="ChromeButton_OnClick"
                HorizontalAlignment="Center"
                Margin="0,0,0,48"
                Padding="22,10"
                FontFamily="Segoe UI"
                FontSize="13"
                Cursor="Hand"
                Background="#111111"
                Foreground="White"
                BorderThickness="0"
                Visibility="Visible">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="22"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#333333" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
