<Window x:Class="FocusHeure.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Heure — Paramètres"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        ResizeMode="CanMinimize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="28">
            <TextBlock Text="Paramètres"
                       FontFamily="Segoe UI Semibold"
                       FontSize="22"
                       Foreground="#111111"
                       Margin="0,0,0,20" />

            <TextBlock Text="Créneaux horaires"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       Margin="0,0,0,8" />
            <ItemsControl x:Name="WindowsList" Margin="0,0,0,8" />
            <Button Content="+ Ajouter un créneau"
                    Click="AddWindow_OnClick"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                    Background="Transparent"
                    BorderBrush="#CCCCCC"
                    Margin="0,0,0,20" />

            <TextBlock Text="Comportement"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       Margin="0,0,0,10" />
            <CheckBox x:Name="WeekendExemptBox" Content="Pas de restriction le week-end" Margin="0,0,0,6" />
            <CheckBox x:Name="ShowCountdownBox" Content="Afficher le temps restant sur l'écran" Margin="0,0,0,6" />
            <CheckBox x:Name="ShowChromeBox" Content="Afficher le bouton Chrome" Margin="0,0,0,6" />
            <CheckBox x:Name="ChromeEnabledBox" Content="Autoriser Chrome pendant les créneaux" Margin="0,0,0,6" />
            <CheckBox x:Name="StartupBox" Content="Lancer au démarrage de Windows" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Pause (minutes)" VerticalAlignment="Center" Width="160" />
                <TextBox x:Name="PauseMinutesBox" Width="60" Padding="4" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Alerte avant créneau (min)" VerticalAlignment="Center" Width="160" />
                <TextBox x:Name="NotifyMinutesBox" Width="60" Padding="4" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Message à l'écran" VerticalAlignment="Center" Width="160" />
                <TextBox x:Name="CustomMessageBox" Width="260" Padding="4" />
            </StackPanel>

            <TextBlock Text="Chrome (chemin vide = auto)"
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox x:Name="ChromePathBox" Padding="6" Margin="0,0,0,16" />

            <TextBlock Text="Process autorisés au-dessus (séparés par ,)"
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox x:Name="AllowedProcessesBox" Padding="6" Margin="0,0,0,16" />

            <TextBlock Text="Code PIN pour quitter (vide = désactivé)"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="PinBox" MaxLength="8" Padding="6" Margin="0,0,0,4" />
            <TextBlock Text="Laissez vide pour ne pas changer le PIN actuel."
                       FontSize="11"
                       Foreground="#888888"
                       Margin="0,0,0,20" />

            <TextBlock x:Name="StatsText"
                       Text=""
                       Foreground="#666666"
                       FontSize="12"
                       Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ouvrir dossier config"
                        Click="OpenFolder_OnClick"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Background="#EEEEEE"
                        BorderThickness="0" />
                <Button Content="Enregistrer"
                        Click="Save_OnClick"
                        Padding="20,8"
                        Background="#111111"
                        Foreground="White"
                        BorderThickness="0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
